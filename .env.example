# Required. Create a key at https://picsart.com/api-platform/docs/authentication
PICSART_API_KEY=

# Optional spend protection. The values below are the defaults.
PICSART_DEMO_ENABLED=true
PICSART_DEMO_VIDEO_ENABLED=true
PICSART_DEMO_WINDOW_SECONDS=3600
PICSART_DEMO_IMAGE_LIMIT=10
PICSART_DEMO_VIDEO_LIMIT=2
PICSART_DEMO_STATUS_LIMIT=1000
PICSART_DEMO_PROMPT_MAX_LENGTH=1000
PICSART_DEMO_VIDEO_SHORTEST=true

# Optional comma-separated model IDs. Empty offers every prompt-only text-to-image or text-to-video model.
PICSART_DEMO_IMAGE_MODELS=
PICSART_DEMO_VIDEO_MODELS=
